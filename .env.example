# ==========================================
# SmartAttend AI - Environment Configuration Example
# Copy this file to .env and fill in real values
# NEVER commit .env to source control
# ==========================================

# Django Backend Settings
DJANGO_SECRET_KEY=replace-with-a-secure-secret-key-min-50-chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL Database Configuration
# Create database using: CREATE DATABASE smartattend_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_NAME=smartattend_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=127.0.0.1
DB_PORT=3306

# CORS Configuration (Frontend URL)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Email Service Configuration (Prepared for Prompt 2 & 3)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_college_or_dept_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_specific_password_here
DEFAULT_FROM_EMAIL=SmartAttend AI <no-reply@smartattend.college.edu>

# AI Assistant Configuration (Prepared for Prompt 5)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_or_openai_api_key_here

# Frontend Vite Environment Variable (Accessible in React via import.meta.env.VITE_API_BASE_URL)
VITE_API_BASE_URL=http://127.0.0.1:8000/api
